.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}
.modal-box {
  position: fixed;
  left: 48rpx; right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  z-index: 101;
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 36rpx;
  text-align: center;
}
.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 32rpx;
}
.btn-cancel {
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d9d9d9;
  background: #fff;
  color: #555;
  font-size: 28rpx;
}
