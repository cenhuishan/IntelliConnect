<view class="container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <empty-view wx:elif="{{list.length === 0}}" text="暂无小智设备，点击+添加" />
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="item-header">
        <text class="item-name">{{item.nickName || item.boardName}}</text>
        <view class="item-actions">
          <view class="tag {{item.status === 'active' ? 'tag-success' : 'tag-default'}}">{{item.status}}</view>
          <text class="action-link" catchtap="onEdit" data-item="{{item}}">编辑</text>
          <text class="action-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
        </view>
      </view>
      <view class="item-info">
        <text class="info-text">板型: {{item.boardType}} - {{item.boardName}}</text>
        <text class="info-text">用户: {{item.userName}}</text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onAdd"><text class="fab-text">+</text></view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">{{editId ? '编辑小智设备' : '添加小智设备'}}</text>
      <scroll-view scroll-y style="max-height:65vh">
        <view class="input-item">
          <text class="input-label">昵称</text>
          <input class="input-field" placeholder="设备昵称" data-field="nickName" bindinput="onFormInput" value="{{form.nickName}}" />
        </view>
        <view class="input-item">
          <text class="input-label">板型</text>
          <picker mode="selector" range="{{boardTypes}}" bindchange="onBoardTypeChange">
            <text class="picker-text">{{form.boardType}}</text>
          </picker>
        </view>
        <view class="input-item">
          <text class="input-label">板名称</text>
          <input class="input-field" placeholder="boardName" data-field="boardName" bindinput="onFormInput" value="{{form.boardName}}" />
        </view>
        <view class="input-item">
          <text class="input-label">用户名</text>
          <input class="input-field" placeholder="用户名" data-field="userName" bindinput="onFormInput" value="{{form.userName}}" />
        </view>
        <view class="input-item">
          <text class="input-label">产品</text>
          <picker mode="selector" range="{{productNames}}" bindchange="onProductChange">
            <text class="picker-text">{{productNames.length ? productNames[0] : '选择产品'}}</text>
          </picker>
        </view>
        <view class="input-item">
          <text class="input-label">设备</text>
          <picker mode="selector" range="{{deviceNames}}" bindchange="onDeviceChange">
            <text class="picker-text">{{deviceNames.length ? deviceNames[0] : '选择设备'}}</text>
          </picker>
        </view>
        <view class="input-item" style="border-bottom:none">
          <text class="input-label">状态</text>
          <picker mode="selector" range="{{statusOptions}}" bindchange="onStatusChange">
            <text class="picker-text">{{form.status}}</text>
          </picker>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmit">确认</button>
      </view>
    </view>
  </view>
</view>
