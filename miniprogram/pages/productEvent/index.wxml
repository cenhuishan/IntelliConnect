<view class="container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <empty-view wx:elif="{{list.length === 0}}" text="暂无事件，点击+添加" />
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id"
          bindtap="onEventTap" data-id="{{item.id}}" data-name="{{item.name}}">
      <view class="item-header">
        <text class="item-name">{{item.name}}</text>
        <view class="item-actions">
          <text class="action-link">查看数据</text>
          <text class="action-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
        </view>
      </view>
      <text class="info-text">{{item.description}}</text>
    </view>
  </view>

  <view class="fab" bindtap="onAdd"><text class="fab-text">+</text></view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加事件</text>
      <view class="input-item">
        <text class="input-label">事件名称</text>
        <input class="input-field" placeholder="事件名称" data-field="name" bindinput="onFormInput" value="{{form.name}}" />
      </view>
      <view class="input-item">
        <text class="input-label">描述</text>
        <input class="input-field" placeholder="事件描述" data-field="description" bindinput="onFormInput" value="{{form.description}}" />
      </view>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">物模型</text>
        <picker mode="selector" range="{{modelNames}}" bindchange="onModelChange">
          <text class="picker-text">{{modelNames.length ? modelNames[0] : '暂无物模型'}}</text>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmit">确认</button>
      </view>
    </view>
  </view>
</view>
