.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1677ff;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
}

.chat-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.clear-btn {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.message-list {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 20rpx;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 12rpx;
  color: #aaa;
  font-size: 26rpx;
}

.msg-wrap {
  display: flex;
  margin-bottom: 20rpx;
}

.user-wrap {
  justify-content: flex-end;
}

.ai-wrap {
  justify-content: flex-start;
}

.bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  word-break: break-word;
}

.user-bubble {
  background: #1677ff;
  border-bottom-right-radius: 4rpx;
}

.ai-bubble {
  background: #fff;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.user-bubble .bubble-text {
  color: #fff;
}

.ai-bubble .bubble-text {
  color: #222;
}

.typing .bubble-text {
  color: #aaa;
}

.input-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f0f0f0;
  gap: 16rpx;
}

.msg-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #222;
}

.send-btn {
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  padding: 18rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1;
  white-space: nowrap;
}

.send-btn.disabled {
  opacity: 0.5;
}
