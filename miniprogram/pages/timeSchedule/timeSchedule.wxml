<view class="container">
  <view class="card">
    <view class="page-header">
      <text class="page-title">定时任务</text>
      <button class="btn-primary" bindtap="openAdd">+ 新建</button>
    </view>
    <view wx:if="{{list.length === 0}}" class="empty">暂无数据</view>
    <view wx:for="{{list}}" wx:key="id" class="list-item">
      <view class="list-item-left">
        <text class="list-item-title">{{item.jobName}}</text>
        <text class="list-item-desc" wx:if="{{'cronExpression'}}">CRONEXPRESSION：{{item.cronExpression}}</text>
      </view>
      <button class="btn-danger" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="modal-box" wx:if="{{showAdd}}">
  <text class="modal-title">新建定时任务</text>
  <view class="form-item">
    <text class="form-label">任务名称 *</text>
    <input class="form-input" value="{{form.jobName}}" data-field="jobName" bindinput="onFormInput" placeholder="请输入任务名称" />
  </view>
  <view class="form-item">
    <text class="form-label">Cron 表达式 *</text>
    <input class="form-input" value="{{form.cronExpression}}" data-field="cronExpression" bindinput="onFormInput" placeholder="请输入Cron 表达式" />
  </view>
  <view class="form-item">
    <text class="form-label">描述</text>
    <input class="form-input" value="{{form.description}}" data-field="description" bindinput="onFormInput" placeholder="请输入描述" />
  </view>
  <view class="modal-footer">
    <button class="btn-cancel" bindtap="closeAdd">取消</button>
    <button class="btn-primary" bindtap="onSubmit">提交</button>
  </view>
</view>
