<view class="container">
  <view class="card server-card">
    <text class="section-title-text">服务器配置</text>
    <view wx:if="{{!editingUrl}}" class="server-row" bindtap="onEditUrl">
      <text class="server-url">{{baseUrl}}</text>
      <text class="edit-btn">编辑</text>
    </view>
    <view wx:else class="edit-row">
      <input class="url-input" value="{{newUrl}}" bindinput="onUrlInput" placeholder="输入服务器地址" />
      <view class="edit-actions">
        <text class="cancel-btn" bindtap="onCancelEdit">取消</text>
        <text class="save-btn" bindtap="onSaveUrl">保存</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title-text">功能菜单</text>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{menus}}" wx:key="page" bindtap="onMenuTap" data-page="{{item.page}}">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card logout-card" bindtap="onLogout">
    <text class="logout-text">退出登录</text>
  </view>
</view>
