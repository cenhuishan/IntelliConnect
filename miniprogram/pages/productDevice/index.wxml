<view class="container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <empty-view wx:elif="{{list.length === 0}}" text="暂无设备，点击+添加" />
  <view wx:else>
    <view class="card device-item" wx:for="{{list}}" wx:key="id">
      <view class="item-header">
        <text class="item-name">{{item.deviceName}}</text>
        <text class="action-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
      </view>
      <view class="item-info">
        <text class="info-text">ClientID: {{item.clientId}}</text>
        <text class="info-text">用户名: {{item.mqttUser}}</text>
        <view class="status-row">
          <view class="tag {{item.online ? 'tag-success' : 'tag-error'}}">
            {{item.online ? '在线' : '离线'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">
    <text class="fab-text">+</text>
  </view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加设备</text>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">设备名称</text>
        <input class="input-field" placeholder="请输入设备名称" data-field="deviceName" bindinput="onFormInput" value="{{form.deviceName}}" />
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmit">确认</button>
      </view>
    </view>
  </view>
</view>
