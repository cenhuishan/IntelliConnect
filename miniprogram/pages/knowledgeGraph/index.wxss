.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.btn-add-sm {
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  border: none;
  line-height: 1.5;
}

.node-list {
  margin-bottom: 24rpx;
}

.node-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border: 2rpx solid transparent;
}

.node-item.selected {
  border-color: #1677ff;
}

.node-left {
  flex: 1;
}

.node-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  display: block;
}

.node-des {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
  display: block;
}

.node-id {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
}

.node-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
}

.action-btn {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.action-btn.edit {
  color: #1677ff;
  border: 2rpx solid #1677ff;
}

.action-btn.del {
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

/* Detail panel */
.detail-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border-left: 6rpx solid #1677ff;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.close-btn {
  font-size: 32rpx;
  color: #aaa;
  padding: 4rpx 12rpx;
}

.detail-section {
  margin-top: 20rpx;
}

.detail-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
}

.add-link {
  font-size: 24rpx;
  color: #1677ff;
}

.detail-empty {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  padding: 16rpx 0;
}

.attr-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.attr-name {
  font-size: 26rpx;
  color: #333;
}

.attr-del {
  font-size: 22rpx;
  color: #ff4d4f;
  padding: 4rpx 12rpx;
}

.rel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rel-info {
  flex: 1;
}

.rel-des {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.rel-nodes {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
  display: block;
}

.rel-del {
  font-size: 22rpx;
  color: #ff4d4f;
  padding: 4rpx 12rpx;
}

/* Modal (reuse from global + products page styles) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 101;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-input {
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.modal-footer .btn-ghost,
.modal-footer .btn-primary {
  flex: 1;
}
