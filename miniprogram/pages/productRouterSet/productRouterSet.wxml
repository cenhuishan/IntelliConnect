<view class="container">
  <view class="card">
    <view class="page-header">
      <text class="page-title">语义路由配置</text>
      <button class="btn-primary" bindtap="openAdd">+ 新建</button>
    </view>
    <view wx:if="{{list.length === 0}}" class="empty">暂无数据</view>
    <view wx:for="{{list}}" wx:key="id" class="list-item">
      <view class="list-item-left">
        <text class="list-item-title">{{item.routerName}}</text>
        <text class="list-item-desc" wx:if="{{'routerContent'}}">ROUTERCONTENT：{{item.routerContent}}</text>
      </view>
      <button class="btn-danger" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="modal-box" wx:if="{{showAdd}}">
  <text class="modal-title">新建语义路由配置</text>
  <view class="form-item">
    <text class="form-label">关联产品 *</text>
    <picker mode="selector" range="{{productOptions}}" range-key="productName" bindchange="onProductChange">
      <view class="form-picker">{{form.productId ? '已选产品 ' + form.productId : '请选择产品'}}</view>
    </picker>
  </view>
  <view class="form-item">
    <text class="form-label">路由名称 *</text>
    <input class="form-input" value="{{form.routerName}}" data-field="routerName" bindinput="onFormInput" placeholder="请输入路由名称" />
  </view>
  <view class="form-item">
    <text class="form-label">路由内容/示例语句 *</text>
    <input class="form-input" value="{{form.routerContent}}" data-field="routerContent" bindinput="onFormInput" placeholder="请输入路由内容/示例语句" />
  </view>
  <view class="modal-footer">
    <button class="btn-cancel" bindtap="closeAdd">取消</button>
    <button class="btn-primary" bindtap="onSubmit">提交</button>
  </view>
</view>
