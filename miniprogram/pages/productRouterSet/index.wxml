<view class="container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <empty-view wx:elif="{{list.length === 0}}" text="暂无路由设置，点击+添加" />
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="item-header">
        <text class="item-name">路由设置 #{{item.id}}</text>
        <text class="action-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
      </view>
      <text class="info-text desc-text">{{item.prompt}}</text>
    </view>
  </view>

  <view class="fab" bindtap="onAdd"><text class="fab-text">+</text></view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加路由设置</text>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">Prompt</text>
        <textarea class="input-field textarea-field" placeholder="输入路由Prompt" data-field="prompt" bindinput="onFormInput" value="{{form.prompt}}" />
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmit">确认</button>
      </view>
    </view>
  </view>
</view>
