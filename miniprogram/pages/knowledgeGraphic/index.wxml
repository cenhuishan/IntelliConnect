<view class="container">

  <!-- Product picker + refresh -->
  <view class="section-card">
    <view class="row-item">
      <text class="row-label required-label">产品</text>
      <picker wx:if="{{productNames.length > 0}}" mode="selector" range="{{productNames}}"
              value="{{currentProductIndex}}" bindchange="onProductChange">
        <view class="picker-box">
          <text class="picker-val">{{productNames[currentProductIndex] || '请选择产品'}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <text wx:else class="empty-tip-inline">{{productLoading ? '加载中...' : '暂无产品'}}</text>
    </view>
    <view class="row-item" style="border-bottom:none">
      <text class="row-label">手动刷新数据</text>
      <button class="refresh-btn" disabled="{{!currentProductId || loading}}" bindtap="loadGraph" size="mini">
        {{loading ? '加载中...' : '刷新'}}
      </button>
    </view>
  </view>

  <!-- Settings (only when a product is selected) -->
  <view class="section-card" wx:if="{{currentProductId !== null}}">
    <view class="row-item">
      <view class="row-label-wrap">
        <text class="row-label">知识图谱自动生成</text>
        <text class="hint-text">超过6轮对话自动生成</text>
      </view>
      <switch checked="{{knowledgeGraphicEnable}}" bindchange="onToggleKg" color="#1890ff" />
    </view>
    <view class="row-item {{knowledgeGraphForgetEnable ? '' : 'last-row'}}">
      <text class="row-label">知识图谱遗忘功能</text>
      <switch checked="{{knowledgeGraphForgetEnable}}" bindchange="onToggleForget" color="#1890ff" />
    </view>
    <view wx:if="{{knowledgeGraphForgetEnable}}" class="row-item last-row">
      <view class="row-label-wrap">
        <text class="row-label">遗忘轮次</text>
        <text class="hint-text">小于4时不生效</text>
      </view>
      <input class="epoch-input" type="number" value="{{knowledgeGraphForgetEpoch}}"
             bindinput="onEpochInput" bindblur="onEpochBlur" />
    </view>
  </view>

  <!-- Tab bar -->
  <view class="tab-bar card">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-idx="0">
      节点（{{nodes.length}}）
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-idx="1">
      关系（{{relations.length}}）
    </view>
    <view class="tab-item {{activeTab === 2 ? 'active' : ''}}" bindtap="onTabChange" data-idx="2">
      图谱
    </view>
  </view>

  <!-- Loading indicator -->
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <!-- ── NODES TAB ─────────────────────────────────────────────────────── -->
  <block wx:elif="{{activeTab === 0}}">
    <view wx:if="{{nodes.length === 0}}" class="empty-tip">暂无节点，点击右下角 + 添加</view>
    <view wx:else>
      <view wx:for="{{nodes}}" wx:key="id" wx:for-item="node">
        <view class="card node-card" bindtap="onNodeTap" data-name="{{node.name}}">

          <!-- Card header (always visible) -->
          <view class="item-header">
            <text class="item-name">{{node.name}}</text>
            <view class="node-meta">
              <view wx:if="{{node.attributes && node.attributes.length > 0}}" class="attr-badge">
                <text>{{node.attributes.length}} 属性</text>
              </view>
              <text class="expand-arrow">{{expandedNodeName === node.name ? '▲' : '▼'}}</text>
            </view>
          </view>
          <text class="info-text desc-text">{{node.des}}</text>

          <!-- ── Expanded detail ── -->
          <view wx:if="{{expandedNodeName === node.name}}" class="node-detail" catchtap="noop">
            <view class="detail-divider"></view>

            <!-- Edit mode -->
            <view wx:if="{{editingNodeName === node.name}}">
              <view class="input-item">
                <text class="input-label">节点名称</text>
                <input class="input-field" value="{{editNodeName}}" maxlength="10"
                       placeholder="不超过10字" bindinput="onEditNodeNameInput" />
              </view>
              <view class="input-item" style="border-bottom:none">
                <text class="input-label">节点描述</text>
                <textarea class="input-field textarea-field" value="{{editNodeDes}}" maxlength="255"
                          placeholder="不超过255字" bindinput="onEditNodeDesInput" />
              </view>
              <view class="detail-footer">
                <button class="detail-btn btn-default-sm" catchtap="onCancelEditNode">取消</button>
                <button class="detail-btn btn-primary-sm" catchtap="onSubmitEditNode">保存</button>
              </view>
            </view>

            <!-- View mode -->
            <view wx:else>
              <!-- Attributes -->
              <view class="attr-section">
                <text class="attr-section-title">属性</text>
                <view class="attr-tags">
                  <view wx:if="{{expandedNodeAttrs.length === 0}}" class="no-attr-tip">
                    <text class="empty-tip-inline">该节点暂无属性</text>
                  </view>
                  <view wx:for="{{expandedNodeAttrs}}" wx:key="id" wx:for-item="attr"
                        wx:for-index="attrIdx" class="attr-tag">
                    <text class="attr-tag-name">{{attr.name}}</text>
                    <text class="attr-tag-del" catchtap="onDeleteAttr"
                          data-attr-name="{{attr.name}}" data-node-name="{{node.name}}">×</text>
                  </view>
                </view>

                <!-- Add attribute inline form -->
                <view wx:if="{{addingAttrForNode === node.name}}" class="add-attr-form">
                  <input class="attr-input" value="{{newAttrName}}" maxlength="10"
                         placeholder="属性名（不超过10字）" bindinput="onNewAttrInput" />
                  <view class="add-attr-btns">
                    <button class="detail-btn btn-default-sm" catchtap="onCancelAddAttr">取消</button>
                    <button class="detail-btn btn-primary-sm" catchtap="onSubmitAddAttr">提交</button>
                  </view>
                </view>
                <button wx:else class="add-attr-btn" catchtap="onStartAddAttr"
                        data-name="{{node.name}}" size="mini">＋ 添加属性</button>
              </view>

              <!-- Node actions -->
              <view class="detail-footer">
                <button class="detail-btn btn-primary-sm" catchtap="onStartEditNode"
                        data-name="{{node.name}}">编辑节点</button>
                <button class="detail-btn btn-danger-sm" catchtap="onDeleteNode"
                        data-name="{{node.name}}">删除节点</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ── RELATIONS TAB ─────────────────────────────────────────────────── -->
  <block wx:elif="{{activeTab === 1}}">
    <view wx:if="{{relations.length === 0}}" class="empty-tip">暂无关系，点击右下角 + 添加</view>
    <view wx:else>
      <view wx:for="{{relations}}" wx:key="id" wx:for-item="rel" wx:for-index="idx">
        <view class="card relation-card" bindtap="onRelationTap" data-idx="{{idx}}">

          <!-- Card header -->
          <view class="item-header">
            <text class="item-name rel-name">{{rel.from}} → {{rel.to}}</text>
            <text class="expand-arrow">{{expandedRelationIdx === idx ? '▲' : '▼'}}</text>
          </view>
          <text class="info-text rel-des">{{rel.des}}</text>

          <!-- ── Expanded detail ── -->
          <view wx:if="{{expandedRelationIdx === idx}}" class="node-detail" catchtap="noop">
            <view class="detail-divider"></view>

            <!-- Edit mode -->
            <view wx:if="{{editingRelationIdx === idx}}">
              <view class="input-item">
                <text class="input-label">源节点</text>
                <input class="input-field" value="{{rel.from}}" disabled />
              </view>
              <view class="input-item">
                <text class="input-label">目标节点</text>
                <input class="input-field" value="{{rel.to}}" disabled />
              </view>
              <view class="input-item" style="border-bottom:none">
                <text class="input-label">关系描述</text>
                <textarea class="input-field textarea-field" value="{{editRelationDes}}" maxlength="255"
                          placeholder="不超过255字" bindinput="onEditRelationDesInput" />
              </view>
              <view class="detail-footer">
                <button class="detail-btn btn-default-sm" catchtap="onCancelEditRelation">取消</button>
                <button class="detail-btn btn-primary-sm" catchtap="onSubmitEditRelation">保存</button>
              </view>
            </view>

            <!-- View mode -->
            <view wx:else>
              <view class="detail-footer">
                <button class="detail-btn btn-primary-sm" catchtap="onStartEditRelation"
                        data-idx="{{idx}}">编辑关系</button>
                <button class="detail-btn btn-danger-sm" catchtap="onDeleteRelation"
                        data-idx="{{idx}}">删除关系</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ── GRAPH TAB ──────────────────────────────────────────────────────── -->
  <block wx:elif="{{activeTab === 2}}">
    <view class="graph-wrap card">
      <canvas type="2d" id="kg-canvas" class="kg-canvas" bindtap="onCanvasTap"></canvas>
    </view>
    <view wx:if="{{graphSelectedNode}}" class="section-card graph-info-panel">
      <view class="graph-node-header">
        <text class="graph-node-name">{{graphSelectedNode}}</text>
        <text class="graph-node-hint">点击空白处取消选中</text>
      </view>
      <view wx:if="{{graphSelectedNodeDes}}" class="graph-node-des">
        <text class="info-text">{{graphSelectedNodeDes}}</text>
      </view>
      <view wx:if="{{graphSelectedNodeRelations.length > 0}}">
        <text class="graph-section-label">关联关系</text>
        <view wx:for="{{graphSelectedNodeRelations}}" wx:key="id" wx:for-item="rel" class="graph-rel-row">
          <text class="graph-rel-text">{{rel.from}} → {{rel.to}}</text>
          <text wx:if="{{rel.des}}" class="graph-rel-des">{{rel.des}}</text>
        </view>
      </view>
      <view wx:else class="empty-tip-inline" style="padding: 16rpx 0;">该节点暂无关联关系</view>
    </view>
  </block>

  <!-- FAB -->
  <view class="fab" bindtap="onFab">
    <text class="fab-text">+</text>
  </view>

  <!-- ── Add Node modal ──────────────────────────────────────────────── -->
  <view class="modal-mask" wx:if="{{showAddNodeModal}}" bindtap="onCloseAddNodeModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加节点</text>
      <view class="input-item">
        <text class="input-label">节点名称</text>
        <input class="input-field" placeholder="不超过10字" maxlength="10"
               value="{{addNodeName}}" bindinput="onAddNodeNameInput" />
      </view>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">节点描述</text>
        <textarea class="input-field textarea-field" placeholder="不超过255字" maxlength="255"
                  value="{{addNodeDes}}" bindinput="onAddNodeDesInput" />
      </view>
      <view class="hint-block">
        <text class="hint-text">提示：节点名称重复时会更新该节点的描述</text>
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseAddNodeModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmitAddNode">确认</button>
      </view>
    </view>
  </view>

  <!-- ── Add Relation modal ───────────────────────────────────────────── -->
  <view class="modal-mask" wx:if="{{showAddRelationModal}}" bindtap="onCloseAddRelationModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加关系</text>
      <view class="input-item">
        <text class="input-label">源节点</text>
        <picker mode="selector" range="{{nodeNames}}" value="{{addRelFromIndex}}"
                bindchange="onAddRelFromChange">
          <view class="picker-box">
            <text class="picker-val">{{nodeNames[addRelFromIndex] || '请选择'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="input-item">
        <text class="input-label">目标节点</text>
        <picker mode="selector" range="{{nodeNames}}" value="{{addRelToIndex}}"
                bindchange="onAddRelToChange">
          <view class="picker-box">
            <text class="picker-val">{{nodeNames[addRelToIndex] || '请选择'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">关系描述</text>
        <textarea class="input-field textarea-field" placeholder="不超过255字（可选）" maxlength="255"
                  value="{{addRelDes}}" bindinput="onAddRelDesInput" />
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseAddRelationModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmitAddRelation">确认</button>
      </view>
    </view>
  </view>

</view>
