/* ── Tab bar ─────────────────────────────────────────────────────────── */
.tab-bar { display: flex; padding: 0; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #999; border-bottom: 4rpx solid transparent; }
.tab-item.active { color: #1890ff; border-bottom-color: #1890ff; font-weight: 600; }

/* ── Section card (product picker / settings) ────────────────────────── */
.section-card { background: #fff; border-radius: 16rpx; padding: 24rpx 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.row-item { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; border-bottom: 1rpx solid #f0f0f0; }
.row-item.last-row { border-bottom: none; }
.row-label { font-size: 28rpx; color: #333; flex: 1; }
.row-label-wrap { display: flex; flex-direction: column; flex: 1; }
.hint-text { font-size: 22rpx; color: #aaa; margin-top: 4rpx; }
.hint-block { padding: 8rpx 0 4rpx; }
.required-label::before { content: '* '; color: #ff4d4f; }
.picker-box { display: flex; align-items: center; }
.picker-val { font-size: 28rpx; color: #1890ff; }
.picker-arrow { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.empty-tip-inline { font-size: 26rpx; color: #999; }
.epoch-input { width: 120rpx; border: 1rpx solid #d9d9d9; border-radius: 8rpx; padding: 8rpx 16rpx; font-size: 28rpx; text-align: center; }
.refresh-btn { background: #f0f8ff; color: #1890ff; border: 1rpx solid #1890ff; border-radius: 8rpx; font-size: 24rpx; padding: 0 24rpx; line-height: 56rpx; height: 56rpx; }

/* ── Node / Relation card ────────────────────────────────────────────── */
.node-card   { margin-bottom: 20rpx; }
.relation-card { margin-bottom: 20rpx; }
.item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: #333; flex: 1; margin-right: 12rpx; }
.node-meta { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.attr-badge { background: #e6f7ff; border: 1rpx solid #91d5ff; border-radius: 20rpx; padding: 2rpx 12rpx; font-size: 22rpx; color: #1890ff; }
.expand-arrow { font-size: 24rpx; color: #aaa; }
.desc-text { margin-top: 4rpx; font-size: 24rpx; color: #888; line-height: 1.5; }
.rel-name { font-size: 30rpx; }
.rel-des   { font-size: 24rpx; color: #888; }

/* ── Expanded node/relation detail ──────────────────────────────────── */
.node-detail { margin-top: 20rpx; }
.detail-divider { height: 1rpx; background: #f0f0f0; margin-bottom: 20rpx; }

/* edit form within the card */
.node-detail .input-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.node-detail .input-label { width: 140rpx; font-size: 26rpx; color: #666; flex-shrink: 0; padding-top: 4rpx; }
.node-detail .input-field { flex: 1; font-size: 26rpx; color: #333; }
.node-detail .textarea-field { min-height: 120rpx; line-height: 1.5; }

/* detail footer buttons */
.detail-footer { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.detail-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0 28rpx; height: 64rpx; border-radius: 8rpx; font-size: 26rpx; line-height: 64rpx; }
.btn-primary-sm { background: #1890ff; color: #fff; }
.btn-default-sm { background: #fff; color: #555; border: 1rpx solid #d9d9d9; }
.btn-danger-sm  { background: #fff; color: #ff4d4f; border: 1rpx solid #ff4d4f; }

/* ── Attribute section (inside expanded node) ───────────────────────── */
.attr-section { margin-bottom: 16rpx; }
.attr-section-title { font-size: 26rpx; color: #666; display: block; margin-bottom: 12rpx; font-weight: 500; }
.attr-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.no-attr-tip { width: 100%; }
.attr-tag { display: flex; align-items: center; background: #e6f7ff; border: 1rpx solid #91d5ff; border-radius: 20rpx; padding: 6rpx 16rpx; }
.attr-tag-name { font-size: 24rpx; color: #096dd9; margin-right: 8rpx; }
.attr-tag-del { font-size: 28rpx; color: #ff7a7a; line-height: 1; }
.add-attr-btn { background: #f0f0f0; color: #555; border: none; border-radius: 20rpx; font-size: 24rpx; padding: 0 20rpx; height: 52rpx; line-height: 52rpx; margin-top: 4rpx; }
.add-attr-form { border: 1rpx solid #e0eeff; border-radius: 10rpx; padding: 16rpx; background: #f8faff; margin-bottom: 8rpx; }
.attr-input { width: 100%; font-size: 26rpx; border: 1rpx solid #d9d9d9; border-radius: 8rpx; padding: 10rpx 16rpx; box-sizing: border-box; margin-bottom: 12rpx; }
.add-attr-btns { display: flex; gap: 12rpx; justify-content: flex-end; }

/* ── Graph canvas view ───────────────────────────────────────────────── */
.graph-wrap { position: relative; border-radius: 12rpx; overflow: hidden; padding: 0; }
.kg-canvas { width: 100%; height: 600rpx; display: block; background: #fafeff; }
.graph-info-panel { margin-top: 0; }
.graph-node-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.graph-node-name { font-size: 30rpx; font-weight: 600; color: #333; }
.graph-node-hint { font-size: 22rpx; color: #bbb; }
.graph-node-des { margin-bottom: 12rpx; }
.graph-section-label { font-size: 24rpx; color: #999; display: block; margin-bottom: 8rpx; margin-top: 8rpx; }
.graph-rel-row { padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.graph-rel-row:last-child { border-bottom: none; }
.graph-rel-text { font-size: 26rpx; color: #333; display: block; }
.graph-rel-des { font-size: 24rpx; color: #888; margin-top: 4rpx; display: block; }
