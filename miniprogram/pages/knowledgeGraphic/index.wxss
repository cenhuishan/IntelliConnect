.tab-bar { display: flex; padding: 0; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #999; border-bottom: 4rpx solid transparent; }
.tab-item.active { color: #1890ff; border-bottom-color: #1890ff; font-weight: 600; }
.item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: #333; flex: 1; }
.action-del { font-size: 26rpx; color: #ff4d4f; }
.nav-hint { font-size: 24rpx; color: #1890ff; }
.info-text { font-size: 24rpx; color: #666; }
.loading-tip { text-align: center; padding: 60rpx; color: #999; }
.empty-tip { text-align: center; color: #999; font-size: 28rpx; padding: 80rpx 0; }
.section-card { background: #fff; border-radius: 16rpx; padding: 24rpx 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.row-item { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; border-bottom: 1rpx solid #f0f0f0; }
.row-item:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: #333; flex: 1; }
.picker-box { display: flex; align-items: center; }
.picker-val { font-size: 28rpx; color: #1890ff; }
.picker-arrow { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.empty-tip-inline { font-size: 26rpx; color: #999; }
.epoch-input { width: 120rpx; border: 1rpx solid #d9d9d9; border-radius: 8rpx; padding: 8rpx 16rpx; font-size: 28rpx; text-align: center; }
