.welcome-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  text-align: center;
  padding: 40rpx;
}
.welcome-title { font-size: 36rpx; font-weight: 700; display: block; }
.welcome-sub { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; display: block; }
.section-title-text { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 24rpx; }
.stat-grid { display: flex; gap: 20rpx; }
.stat-card { flex: 1; background: #f5f6fa; border-radius: 12rpx; padding: 24rpx; text-align: center; }
.stat-card.online { background: #f6ffed; }
.stat-card.offline { background: #fff2f0; }
.stat-num { font-size: 48rpx; font-weight: 700; color: #1890ff; display: block; }
.online-num { color: #52c41a; }
.offline-num { color: #ff4d4f; }
.stat-label { font-size: 24rpx; color: #666; margin-top: 8rpx; display: block; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.action-item { background: #f5f6fa; border-radius: 12rpx; padding: 32rpx; text-align: center; display: flex; flex-direction: column; align-items: center; }
.action-icon { font-size: 48rpx; margin-bottom: 12rpx; }
.action-text { font-size: 26rpx; color: #333; }
