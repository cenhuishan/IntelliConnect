.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.btn-add {
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  border: none;
  line-height: 1.5;
}

.product-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.product-item.active {
  border-color: #1677ff;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  display: block;
}

.product-id {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  display: block;
}

.active-tag {
  font-size: 22rpx;
  color: #1677ff;
  margin-top: 6rpx;
  display: block;
}

.btn-unbind {
  font-size: 24rpx;
  color: #ff4d4f;
  background: transparent;
  border: 2rpx solid #ff4d4f;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  line-height: 1.5;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 101;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-input {
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.modal-footer .btn-ghost,
.modal-footer .btn-primary {
  flex: 1;
}
