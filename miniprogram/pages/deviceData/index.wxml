<view class="container">
  <view class="device-header card">
    <text class="device-name-title">{{deviceName}}</text>
  </view>

  <!-- Property key selector -->
  <view class="filter-row card">
    <text class="filter-label">属性</text>
    <picker bindchange="onKeyChange" value="{{0}}" range="{{jsonKeys}}">
      <view class="picker-val">{{selectedKey || '选择属性'}} ›</view>
    </picker>
  </view>

  <!-- Time range selector -->
  <view class="range-row">
    <view
      class="range-btn {{range === 'today' ? 'active' : ''}}"
      data-range="today"
      bindtap="onRangeChange"
    >今天</view>
    <view
      class="range-btn {{range === 'week' ? 'active' : ''}}"
      data-range="week"
      bindtap="onRangeChange"
    >近7天</view>
  </view>

  <!-- Data table -->
  <view wx:if="{{loading}}" class="empty-state">加载中...</view>
  <view wx:elif="{{chartData.length === 0}}" class="empty-state">暂无数据</view>
  <view wx:else class="card">
    <view class="table-header">
      <text class="table-cell">时间</text>
      <text class="table-cell">数值</text>
    </view>
    <view class="table-row" wx:for="{{chartData}}" wx:key="id">
      <text class="table-cell time-cell">{{item.time}}</text>
      <text class="table-cell">{{item.value}}</text>
    </view>
  </view>
</view>
