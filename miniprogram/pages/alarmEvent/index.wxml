<view class="container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <empty-view wx:elif="{{list.length === 0}}" text="暂无报警事件" />
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="item-header">
        <text class="item-name">{{item.alarmName}}</text>
        <text class="action-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
      </view>
      <text class="info-text">Key: {{item.alarmKey}}</text>
      <text class="info-text">触发值: {{item.alarmValue}}</text>
    </view>
  </view>
  <view class="fab" bindtap="onAdd"><text class="fab-text">+</text></view>
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加报警事件</text>
      <view class="input-item">
        <text class="input-label">报警名称</text>
        <input class="input-field" placeholder="报警名称" data-field="alarmName" bindinput="onFormInput" value="{{form.alarmName}}" />
      </view>
      <view class="input-item">
        <text class="input-label">属性Key</text>
        <input class="input-field" placeholder="触发属性Key" data-field="alarmKey" bindinput="onFormInput" value="{{form.alarmKey}}" />
      </view>
      <view class="input-item" style="border-bottom:none">
        <text class="input-label">触发值</text>
        <input class="input-field" placeholder="触发阈值" data-field="alarmValue" bindinput="onFormInput" value="{{form.alarmValue}}" />
      </view>
      <view class="modal-footer">
        <button class="btn btn-default" bindtap="onCloseModal">取消</button>
        <button class="btn btn-primary" bindtap="onSubmit">确认</button>
      </view>
    </view>
  </view>
</view>
