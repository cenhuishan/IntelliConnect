<view class="container">
  <view class="card">
    <view class="page-header">
      <text class="page-title">物模型列表</text>
      <button class="btn-primary" bindtap="openAdd">+ 新建</button>
    </view>
    <view wx:if="{{list.length === 0}}" class="empty">暂无物模型数据</view>
    <view wx:for="{{list}}" wx:key="id" class="list-item">
      <view class="list-item-left">
        <text class="list-item-title">{{item.name}}</text>
        <text class="list-item-desc">ID: {{item.id}} · 产品: {{item.productId}} · {{item.description}}</text>
      </view>
      <button class="btn-danger" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
</view>

<!-- 新建弹层 -->
<view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="modal-box card" wx:if="{{showAdd}}">
  <text class="modal-title">新建物模型</text>
  <view class="form-item">
    <text class="form-label">物模型名称 *</text>
    <input class="form-input" value="{{form.name}}" data-field="name" bindinput="onFormInput" placeholder="请输入物模型名称" />
  </view>
  <view class="form-item">
    <text class="form-label">关联产品 *</text>
    <picker mode="selector" range="{{productOptions}}" range-key="productName" bindchange="onProductChange">
      <view class="form-picker">
        {{form.productId ? '已选择产品 ' + form.productId : '请选择产品'}}
      </view>
    </picker>
  </view>
  <view class="form-item">
    <text class="form-label">描述 *</text>
    <input class="form-input" value="{{form.description}}" data-field="description" bindinput="onFormInput" placeholder="请输入描述" />
  </view>
  <view class="modal-footer">
    <button class="btn-cancel" bindtap="closeAdd">取消</button>
    <button class="btn-primary" bindtap="onSubmit">提交</button>
  </view>
</view>
