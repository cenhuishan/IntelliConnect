/* Global styles */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

/* Card */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* Primary button */
.btn-primary {
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  width: 100%;
  border: none;
}

/* Ghost button */
.btn-ghost {
  background: transparent;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 30rpx;
  width: 100%;
}

/* Status badge */
.badge-online {
  color: #52c41a;
  font-size: 24rpx;
}

.badge-offline {
  color: #ff4d4f;
  font-size: 24rpx;
}

/* Section title */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

/* Empty state */
.empty-state {
  text-align: center;
  color: #aaa;
  padding: 80rpx 0;
  font-size: 28rpx;
}
