/* 全局样式 */
page {
  background-color: #f0f2f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #f0f2f5;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 统计数字卡片行 */
.stat-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  margin: 0 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.stat-card:first-child { margin-left: 0; }
.stat-card:last-child  { margin-right: 0; }
.stat-num {
  font-size: 52rpx;
  font-weight: bold;
  color: #1890ff;
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* 主按钮 */
.btn-primary {
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1.5;
}
.btn-primary:active { opacity: 0.85; }

/* 危险按钮 */
.btn-danger {
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.5;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.list-item:last-child { border-bottom: none; }
.list-item-left  { flex: 1; overflow: hidden; }
.list-item-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.list-item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.tag-blue   { background: #e6f7ff; color: #1890ff; }
.tag-green  { background: #f6ffed; color: #52c41a; }
.tag-orange { background: #fff7e6; color: #fa8c16; }
.tag-red    { background: #fff1f0; color: #ff4d4f; }

/* 表单 */
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 10rpx;
  display: block;
}
.form-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}
.form-input:focus { border-color: #1890ff; }
.form-picker {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
  color: #333;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* 页面标题行 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 菜单入口 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}
.menu-item {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.menu-item-icon { font-size: 44rpx; margin-bottom: 12rpx; }
.menu-item-title { font-size: 28rpx; font-weight: 500; color: #333; }
.menu-item-desc  { font-size: 22rpx; color: #999; margin-top: 6rpx; }
