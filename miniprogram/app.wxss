page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f6fa;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
}

.btn-default {
  background: #fff;
  color: #333;
  border: 1rpx solid #d9d9d9;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.list-item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-success {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-error {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.tag-default {
  background: #fafafa;
  color: #666;
  border: 1rpx solid #d9d9d9;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1890ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.5);
  z-index: 100;
}

.fab-text {
  color: #fff;
  font-size: 60rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: 60rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-footer .btn {
  flex: 1;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 24rpx 8rpx;
  background: #f5f6fa;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* ===== List Item Styles ===== */
.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.item-info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}

.info-text {
  font-size: 24rpx;
  color: #888;
  display: block;
}

.desc-text {
  margin-top: 12rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.action-link {
  font-size: 26rpx;
  color: #1890ff;
}

.action-del {
  font-size: 26rpx;
  color: #ff4d4f;
}

/* ===== Picker ===== */
.picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ===== Loading & Status ===== */
.loading-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* ===== Section Title ===== */
.section-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* ===== Textarea ===== */
.textarea-field {
  min-height: 160rpx;
  line-height: 1.6;
  padding: 8rpx 0;
  font-size: 28rpx;
}

/* ===== Device Data Display ===== */
.data-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.data-key {
  width: 200rpx;
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
  font-weight: 500;
}

.data-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.query-btn {
  margin-top: 24rpx;
}

/* ===== Upload Area ===== */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #888;
}

/* ===== Action Row ===== */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

/* ===== Recall Result ===== */
.recall-result {
  margin: 20rpx 0;
  padding: 20rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.result-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ===== MCP Endpoint Info ===== */
.endpoint-btn {
  height: 76rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.endpoint-info {
  background: #f5f6fa;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.endpoint-label {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 8rpx;
}

.endpoint-url {
  font-size: 26rpx;
  color: #1890ff;
  word-break: break-all;
  user-select: all;
}

.tool-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.tool-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== Nav hint ===== */
.nav-hint {
  font-size: 22rpx;
  color: #bbb;
}

/* ===== Status row ===== */
.status-row {
  margin-top: 12rpx;
}

/* ===== Logout ===== */
.logout-card {
  text-align: center;
  background: #fff1f0;
  cursor: pointer;
}

.logout-text {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: 500;
}

/* ===== Server card ===== */
.server-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.server-url {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.edit-btn {
  font-size: 26rpx;
  color: #1890ff;
  margin-left: 20rpx;
}

.edit-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.url-input {
  width: 100%;
  font-size: 28rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 16rpx;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.cancel-btn {
  font-size: 26rpx;
  color: #888;
}

.save-btn {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ===== Menu List in Setting ===== */
.menu-list {
  margin-top: 12rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #bbb;
}

/* ===== Product Menu Grid ===== */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  min-height: 140rpx;
}

.menu-item .menu-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  margin-right: 0;
}

.menu-item .menu-title {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

/* ===== Dashboard Stats ===== */
.stat-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.online-num { color: #52c41a; }
.offline-num { color: #ff4d4f; }

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 16rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #f0f8ff;
  border-radius: 12rpx;
  min-height: 120rpx;
}

.action-item .action-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

/* ===== Welcome Card ===== */
.welcome-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.welcome-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* ===== Login page ===== */
.login-container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #888;
}

.form-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 32rpx;
}

.login-btn {
  width: 100%;
  margin-bottom: 24rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
}

.link-area {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.link-text {
  font-size: 28rpx;
  color: #1890ff;
}

.link-divider {
  color: #d9d9d9;
}

/* ===== KnowledgeGraphic ===== */
.graph-container {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* ===== Product Info ===== */
.product-info {
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.product-id {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== Filter Card ===== */
.filter-card {
  margin-bottom: 20rpx;
}

/* ===== Register/About page styles ===== */
.form-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.code-btn {
  min-width: 200rpx;
  height: 70rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 0 20rpx;
}
